{
  "name": "@solvyst-atlas/server",
  "version": "1.0.0",
  "description": "Solvyst Atlas API server",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --dir ../.. --filter @solvyst-atlas/database build && tsc && tsc-alias",
    "start": "node dist/server.js",
    "worker:email": "tsx src/modules/notification/email/workers/email.worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@solvyst-atlas/database": "workspace:*",
    "bullmq": "^5.58.5",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "morgan": "^1.11.0",
    "zod": "^4.1.7"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "globals": "^17.9.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
