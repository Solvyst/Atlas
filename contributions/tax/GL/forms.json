{
  "countryCode": "GL",
  "version": 1,
  "name": "Greenland",
  "fields": [
    {
      "code": "CPR",
      "label": "CPR Number",
      "description": "Civil Registration Number used as the Tax Identification Number (TIN) for individuals in Greenland",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "0101901234",
      "normalization": {
        "trim": true,
        "uppercase": false,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{10}$",
        "minLength": 10,
        "maxLength": 10
      }
    },
    {
      "code": "CVR",
      "label": "CVR Number",
      "description": "Central Business Register number used as the Tax Identification Number (TIN) for businesses in Greenland",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "12345678",
      "normalization": {
        "trim": true,
        "uppercase": false,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{8}$",
        "minLength": 8,
        "maxLength": 8
      }
    }
  ]
