{
  "countryCode": "VI",
  "version": 1,
  "name": "United States Virgin Islands",
  "fields": [
    {
      "code": "SSN",
      "label": "SSN",
      "description": "Social Security Number used as a taxpayer identification number for individuals",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "123-45-6789",
      "normalization": {
        "trim": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{3}-?[0-9]{2}-?[0-9]{4}$",
        "minLength": 9,
        "maxLength": 11
      }
    },
    {
      "code": "ITIN",
      "label": "ITIN",
      "description": "Individual Taxpayer Identification Number for certain individuals who need a U.S. taxpayer identification number but are not eligible for a Social Security Number",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "912-70-1234",
      "normalization": {
        "trim": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^9[0-9]{2}-?(5[0-9]|6[0-5]|7[0-9]|8[0-8]|9[0-2]|9[4-9])-?[0-9]{4}$",
        "minLength": 9,
        "maxLength": 11
      }
    },
    {
      "code": "EIN",
      "label": "EIN",
      "description": "Employer Identification Number used to identify businesses and other entities for tax filing and reporting purposes",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "12-3456789",
      "normalization": {
        "trim": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{2}-?[0-9]{7}$",
        "minLength": 9,
        "maxLength": 10
      }
    }
  ]
}