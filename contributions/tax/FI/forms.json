{
  "countryCode": "FI",
  "version": 1,
  "name": "Finland",
  "fields": [
    {
      "code": "PERSONAL_IDENTITY_CODE",
      "label": "Personal Identity Code",
      "description": "Finnish personal identity code used as the taxpayer identifier (TIN) for individuals",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "121204A959C",
      "normalization": {
        "trim": true,
        "uppercase": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": null,
        "minLength": 11,
        "maxLength": 11
      }
    },
    {
      "code": "BUSINESS_ID",
      "label": "Business ID",
      "description": "Finnish Business Identity Code (Y-tunnus), used as the taxpayer identifier (TIN) for businesses and organizations",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "1234567-8",
      "normalization": {
        "trim": true,
        "uppercase": false,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{7}-[0-9]$",
        "minLength": 9,
        "maxLength": 9
      }
    },
    {
      "code": "VAT_NUMBER",
      "label": "VAT Number",
      "description": "Finnish Value Added Tax identification number formed from the Business ID for businesses registered for VAT",
      "category": "TAX_REGISTRATION",
      "appliesTo": [
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "FI12345678",
      "normalization": {
        "trim": true,
        "uppercase": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^FI[0-9]{8}$",
        "minLength": 10,
        "maxLength": 10
      }
    }
  ]
}