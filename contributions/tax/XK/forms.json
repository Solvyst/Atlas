{
  "countryCode": "XK",
  "version": 1,
  "name": "Kosovo",
  "fields": [
    {
      "code": "UIN",
      "label": "Unique Identification Number (UIN)",
      "description": "Unique Identification Number issued by the Kosovo Business Registration Agency to registered business organizations and used for tax registration purposes.",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "810000001",
      "normalization": {
        "trim": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^81[0-9]{7}$",
        "minLength": 9,
        "maxLength": 9
      }
    },
    {
      "code": "FISCAL_NUMBER",
      "label": "Fiscal Number",
      "description": "Taxpayer identification number issued or recognized by the Tax Administration of Kosovo for administration of the tax system.",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON",
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "600000001",
      "normalization": {
        "trim": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^6[0-9]{8}$",
        "minLength": 9,
        "maxLength": 9
      }
    },
    {
      "code": "VAT_NUMBER",
      "label": "VAT Number",
      "description": "Value Added Tax registration number issued by the Tax Administration of Kosovo to VAT-registered taxable persons.",
      "category": "TAX_REGISTRATION",
      "appliesTo": [
        "PERSON",
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "330000001",
      "normalization": {
        "trim": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^3[0-9]{8}$",
        "minLength": 9,
        "maxLength": 9
      }
    }
  ]
}