{
  "countryCode": "CZ",
  "version": 1,
  "name": "Czechia",
  "fields": [
    {
      "code": "DIC",
      "label": "DIČ",
      "description": "Daňové identifikační číslo (Tax Identification Number)",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON",
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "CZ12345678",
      "normalization": {
        "trim": true,
        "uppercase": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^CZ[0-9]{8,10}$",
        "minLength": 10,
        "maxLength": 12
      }
    },
    {
      "code": "RC",
      "label": "Rodné číslo",
      "description": "Birth Number used as the tax identification number for natural persons where applicable",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "8501011234",
      "normalization": {
        "trim": true,
        "uppercase": false,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{9,10}$",
        "minLength": 9,
        "maxLength": 10
      }
    }
  ]
}