{
  "countryCode": "HR",
  "version": 1,
  "name": "Croatia",
  "fields": [
    {
      "code": "OIB",
      "label": "OIB",
      "description": "Osobni identifikacijski broj (Personal Identification Number)",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON",
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "12345678901",
      "normalization": {
        "trim": true,
        "uppercase": false,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{11}$",
        "minLength": 11,
        "maxLength": 11
      }
    },
    {
      "code": "VAT_ID",
      "label": "VAT Identification Number",
      "description": "Croatian VAT identification number (PDV identifikacijski broj), formed with the HR country prefix followed by the 11-digit OIB",
      "category": "TAX_REGISTRATION",
      "appliesTo": [
        "PERSON",
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "HR12345678901",
      "normalization": {
        "trim": true,
        "uppercase": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^HR[0-9]{11}$",
        "minLength": 13,
        "maxLength": 13
      }
    }
  ]
