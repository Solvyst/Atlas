{
  "countryCode": "TW",
  "version": 1,
  "name": "Taiwan",
  "fields": [
    {
      "code": "NATIONAL_ID_NUMBER",
      "label": "National ID Number",
      "description": "National Identification Number used by Taiwan nationals with household registration, including for tax identification purposes",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "A123456789",
      "normalization": {
        "trim": true,
        "uppercase": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[A-Z][12][0-9]{8}$",
        "minLength": 10,
        "maxLength": 10
      }
    },
    {
      "code": "UI_NUMBER",
      "label": "Uniform Identification Number",
      "description": "Uniform Identification Number used by foreign nationals and other persons without a Taiwan National ID Number, including for tax purposes",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "A812345678",
      "normalization": {
        "trim": true,
        "uppercase": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[A-Z][89][0-9]{8}$",
        "minLength": 10,
        "maxLength": 10
      }
    },
    {
      "code": "BAN",
      "label": "Business Administration Number",
      "description": "Eight-digit Business Administration Number (BAN) used to identify business entities for taxation and business tax purposes",
      "category": "TAX_REGISTRATION",
      "appliesTo": [
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "12345678",
      "normalization": {
        "trim": true,
        "uppercase": false,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{8}$",
        "minLength": 8,
        "maxLength": 8
      }
    }
  ]
}