{
  "countryCode": "SI",
  "version": 1,
  "name": "Slovenia",
  "fields": [
    {
      "code": "TAX_NUMBER",
      "label": "Tax Number",
      "description": "Slovenian tax identification number (davčna številka) assigned upon entry in the Tax Register",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON",
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "12345678",
      "normalization": {
        "trim": true,
        "uppercase": false,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{8}$",
        "minLength": 8,
        "maxLength": 8
      }
    },
    {
      "code": "VAT_ID",
      "label": "VAT Identification Number",
      "description": "Slovenian VAT identification number, consisting of the prefix SI followed by the taxpayer's eight-digit tax number",
      "category": "TAX_REGISTRATION",
      "appliesTo": [
        "PERSON",
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "SI12345678",
      "normalization": {
        "trim": true,
        "uppercase": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^SI[0-9]{8}$",
        "minLength": 10,
        "maxLength": 10
      }
    }
  ]
}