        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{11}$",
        "minLength": 11,
        "maxLength": 11
      }
    },
    {
      "code": "ENTERPRISE_NUMBER",
      "label": "Enterprise Number",
      "description": "Unique enterprise identification number assigned by the Crossroads Bank for Enterprises (CBE/KBO/BCE)",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON",
        "ORGANIZATION"
      ],
