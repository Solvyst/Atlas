        "uppercase": false,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{13}$",
        "minLength": 13,
        "maxLength": 13
      }
    },
    {
      "code": "QUALIFIED_INVOICE_ISSUER_NUMBER",
