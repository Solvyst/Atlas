{
  "countryCode": "JP",
  "version": 1,
  "name": "Japan",
  "fields": [
    {
      "code": "MY_NUMBER",
      "label": "My Number",
      "description": "Individual Number (My Number) used for social security, tax, and disaster response procedures",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "123456789012",
      "normalization": {
        "trim": true,
        "uppercase": false,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{12}$",
        "minLength": 12,
        "maxLength": 12
      }
    },
    {
      "code": "CORPORATE_NUMBER",
      "label": "Corporate Number",
      "description": "Corporate Number assigned by Japan's National Tax Agency to corporations and certain other organizations",
