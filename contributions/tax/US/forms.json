{
  "countryCode": "US",
  "version": 1,
  "name": "United States",
  "fields": [
    {
      "code": "SSN",
      "label": "SSN",
      "description": "Social Security Number used as a taxpayer identification number for individuals",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "123456789",
      "normalization": {
        "trim": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{9}$",
        "minLength": 9,
        "maxLength": 9
      }
    },
    {
      "code": "EIN",
      "label": "EIN",
      "description": "Employer Identification Number, a federal tax identification number for businesses and other entities",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "123456789",
      "normalization": {
        "trim": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{9}$",
        "minLength": 9,
        "maxLength": 9
      }
    },
    {
      "code": "ITIN",
      "label": "ITIN",
      "description": "Individual Taxpayer Identification Number issued by the IRS to certain individuals who need a U.S. taxpayer identification number but are not eligible for an SSN",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "912345678",
      "normalization": {
        "trim": true,
        "removeSpaces": true
