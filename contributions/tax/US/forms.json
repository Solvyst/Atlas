        "minLength": 9,
        "maxLength": 9
      }
    },
    {
      "code": "ATIN",
      "label": "ATIN",
      "description": "Adoption Taxpayer Identification Number issued by the IRS for certain children in the process of domestic adoption",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "900000001",
      "normalization": {
        "trim": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{9}$",
        "minLength": 9,
        "maxLength": 9
      }
    },
    {
      "code": "PTIN",
      "label": "PTIN",
      "description": "Preparer Tax Identification Number issued by the IRS to paid federal tax return preparers",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "P12345678",
      "normalization": {
        "trim": true,
