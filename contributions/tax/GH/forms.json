      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "GHA-123456789-1",
      "normalization": {
        "trim": true,
        "uppercase": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^GHA-[0-9]{9}-[0-9]$",
        "minLength": 15,
        "maxLength": 15
      }
    },
    {
