  "version": 1,
  "name": "Ghana",
  "fields": [
    {
      "code": "GHANA_CARD_PIN",
      "label": "Ghana Card PIN",
      "description": "Ghana Card Personal Identification Number used as the Taxpayer Identification Number for individual taxpayers",
