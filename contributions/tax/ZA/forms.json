{
  "countryCode": "ZA",
  "version": 1,
  "name": "South Africa",
  "fields": [
    {
      "code": "INCOME_TAX_REFERENCE_NUMBER",
      "label": "Income Tax Reference Number",
      "description": "10-digit tax reference number allocated by the South African Revenue Service (SARS) for income tax.",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON",
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "0123456789",
      "normalization": {
        "trim": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{10}$",
        "minLength": 10,
        "maxLength": 10
      }
    },
    {
      "code": "VAT_NUMBER",
