{
  "countryCode": "SK",
  "version": 1,
  "name": "Slovakia",
  "fields": [
    {
      "code": "DIC",
      "label": "DIČ",
      "description": "Daňové identifikačné číslo (Tax Identification Number) assigned by the Slovak tax authority",
