      "appliesTo": [
        "PERSON",
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "2004567890",
      "normalization": {
        "trim": true,
        "uppercase": false,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[0-9]{10}$",
        "minLength": 10,
        "maxLength": 10
      }
    },
    {
      "code": "IC_DPH",
      "label": "IČ DPH",
      "description": "Identifikačné číslo pre daň (VAT identification number) assigned for Slovak VAT registration",
