      "appliesTo": [
        "PERSON",
        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "SK2020123456",
      "normalization": {
        "trim": true,
        "uppercase": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^SK[0-9]{10}$",
        "minLength": 12,
        "maxLength": 12
      }
    }
