{
  "countryCode": "SG",
  "version": 1,
  "name": "Singapore",
  "fields": [
    {
      "code": "NRIC_FIN",
      "label": "NRIC / FIN",
      "description": "National Registration Identity Card number or Foreign Identification Number used by IRAS as the tax reference number for individual taxpayers",
      "category": "TAX_IDENTIFIER",
      "appliesTo": [
        "PERSON"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "S1234567A",
      "normalization": {
        "trim": true,
        "uppercase": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": "^[STFGM][0-9]{7}[A-Z]$",
        "minLength": 9,
        "maxLength": 9
      }
    },
    {
      "code": "UEN",
      "label": "UEN",
      "description": "Unique Entity Number used as the tax reference number for Singapore businesses, companies and other registered entities",
