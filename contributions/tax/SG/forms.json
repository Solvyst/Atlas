        "ORGANIZATION"
      ],
      "required": false,
      "inputType": "TEXT",
      "placeholder": "200312345A",
      "normalization": {
        "trim": true,
        "uppercase": true,
        "removeSpaces": true
      },
      "validation": {
        "pattern": null,
        "minLength": 9,
        "maxLength": 10
      }
    },
    {
      "code": "GST_REGISTRATION_NUMBER",
      "label": "GST Registration Number",
      "description": "Goods and Services Tax registration number used for GST-registered persons where a separate GST registration number is issued instead of the entity's UEN",
      "category": "TAX_REGISTRATION",
      "appliesTo": [
