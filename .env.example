# Solvyst Atlas self-host environment
# Copy this file to .env and update values for your deployment.

# -------------------
# APP
# -------------------
APP_NAME="Solvyst Atlas"
APP_VERSION=0.1.0
NODE_ENV=production
HOST=0.0.0.0
PORT=5000
WEB_URL=http://localhost:3000
CORS_ORIGINS=*

# -------------------
# DATABASE
# DATABASE_URI is used by local pnpm commands.
# DOCKER_DATABASE_URI is used by docker-compose server containers.
# -------------------
DATABASE_URI="postgresql://solvyst_atlas:solvyst_atlas@127.0.0.1:5432/solvyst_atlas?sslmode=disable"
DOCKER_DATABASE_URI="postgresql://solvyst_atlas:solvyst_atlas@postgres:5432/solvyst_atlas?sslmode=disable"
POSTGRES_DB=solvyst_atlas
POSTGRES_USER=solvyst_atlas
POSTGRES_PASSWORD="solvyst_atlas"
POSTGRES_PORT=5432

# -------------------
# ATLAS API
# -------------------
ATLAS_API_KEY=replace-with-at-least-32-random-characters
META_RATE_LIMIT_MAX=120
META_RATE_LIMIT_WINDOW_MS=60000

# -------------------
# REDIS
# -------------------
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_TLS=false
BULL_PREFIX=solvyst-atlas
EMAIL_QUEUE_RETRY=3
EMAIL_QUEUE_CONCURRENCY=5
