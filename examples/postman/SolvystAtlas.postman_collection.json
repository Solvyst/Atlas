{
  "info": {
    "name": "Solvyst Atlas API",
    "description": "Ready-to-run examples for Solvyst Atlas Meta, Reference, and Tax APIs. Set BASE_URL and ATLAS_API_KEY collection variables before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Meta API",
      "item": [
        {
          "name": "Geo States",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/meta/geo?country=india"
          }
        },
        {
          "name": "Regions",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/meta/regions?search=asia"
          }
        },
        {
          "name": "Countries",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/meta/countries?search=india"
          }
        },
        {
          "name": "States",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/meta/states?countryCode=IN"
          }
        },
        {
          "name": "Cities",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/meta/cities?search=bhubaneswar"
          }
        },
        {
          "name": "Admin Areas",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/meta/admin-areas?countryCode=US&type=county"
          }
        },
        {
          "name": "Localities",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/meta/localities?countryCode=IN&search=bhubaneswar"
          }
        },
        {
          "name": "Phone Codes",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/meta/phone-codes?dialCode=%2B91"
          }
        },
        {
          "name": "Languages",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/meta/languages?code=hi"
          }
        },
        {
          "name": "Locales",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/meta/locales?countryCode=IN"
          }
        },
        {
          "name": "Currencies",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/meta/currencies?search=INR"
          }
        },
        {
          "name": "Timezones",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/meta/timezones?countryId=101"
          }
        }
      ]
    },
    {
      "name": "Reference API",
      "item": [
        {
          "name": "Address Formats",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/reference/address-formats?countryCode=IN"
          }
        }
      ]
    },
    {
      "name": "Tax API",
      "item": [
        {
          "name": "Tax Forms",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/tax/forms?search=india"
          }
        },
        {
          "name": "Tax Form By Country",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{ATLAS_API_KEY}}" }],
            "url": "{{BASE_URL}}/api/v1/tax/forms/IN"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:3100"
    },
    {
      "key": "ATLAS_API_KEY",
      "value": "replace-with-your-atlas-api-key",
      "type": "secret"
    }
  ]
}
