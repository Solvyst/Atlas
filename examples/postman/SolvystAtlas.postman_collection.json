{
  "info": {
    "name": "Solvyst Atlas API",
    "description": "Ready-to-run examples for Solvyst Atlas Meta and Reference APIs. Set BASE_URL and META_API_KEY collection variables before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Meta API",
      "item": [
        {
          "name": "Geo States",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{META_API_KEY}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/meta/geo?country=india",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "meta",
                "geo"
              ],
              "query": [
                {
                  "key": "country",
                  "value": "india"
                }
              ]
            }
          }
        },
