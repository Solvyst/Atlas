{
  "name": "@solvyst-atlas/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "contrib:validate:geo": "node ./bin/scripts/validation/geo-contributions.mjs",
    "contrib:validate:tax": "node ./bin/scripts/validation/tax-contributions.mjs",
    "contrib:validate": "pnpm contrib:validate:geo && pnpm contrib:validate:tax",
    "import:geo": "pnpm contrib:validate:geo && node ./bin/scripts/import/geo.mjs",
    "import:tax": "pnpm contrib:validate:tax && node ./bin/scripts/import/tax.mjs",
    "import:all": "pnpm import:geo && pnpm import:tax",
    "cli": "node ./bin/console.mjs",
    "export:csv": "pnpm contrib:validate && node ./bin/scripts/export/csv.mjs",
    "export:all": "pnpm export:csv"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.10",
    "rimraf": "^5.0.10",
    "typescript": "^5.9.3"
  }
}
